# Copy this file to .env and fill in real values there.
# .env should already be listed in your .gitignore — never commit it.

# From Twitch Dev Console > your app's page
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# From Firebase Console > Realtime Database page (URL) and
# Project settings > Service accounts > Database secrets (secret)
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_SECRET=

# Your real Netlify site URL once deployed, no trailing slash
# e.g. https://deacon413.netlify.app
PUBLIC_BASE_URL=

# Make this one up yourself — any random string, e.g. run:
#   openssl rand -hex 20
TWITCH_EVENTSUB_SECRET=
